# CISO Assistant connection
# Do not commit real tokens, passwords, internal IP addresses or production URLs.
CISO_BASE_URL=https://localhost:8443/api
CISO_API_TOKEN=your_api_token_here
CISO_VERIFY_SSL=false

# Optional local LLM / enterprise LLM settings
LLM_PROVIDER=local_or_company_llm
OLLAMA_BASE_URL=http://localhost:11434/
OLLAMA_MODEL=qwen-or-other-model
OLLAMA_TIMEOUT=60000

# PDF parsing
PDF_ENABLE_OCR=true
PDF_TEXT_MIN_CHARS=300
PDF_MIN_AVG_CHARS_PER_PAGE=50
PDF_RENDER_DPI=200
EXTRACTED_TEXT_DIR=storage/extracted_text
PDF_RENDERED_PAGES_DIR=storage/rendered_pages

# Evidence input / output
ASSESSMENT_ID=your_assessment_id_here
EVIDENCE_INPUT_DIR=demo_data/input
EVIDENCE_OUTPUT_DIR=demo_outputs

# Runtime switches
DEBUG_MODE=0
APPLY_IMPORT=0
AUTO_APPLY_REVIEW_DECISION=0
CISO_SCORE_WRITE_MODE=none

# Matching controls
ATTACH_MIN_SCORE=0.40
FINAL_TARGET_TOP_K=10
